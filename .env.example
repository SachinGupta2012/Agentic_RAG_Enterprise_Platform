APP_NAME=Enterprise Support Intelligence Platform
APP_ENV=development
API_V1_PREFIX=/api/v1

# Qdrant Cloud (free tier). Keep real credentials in .env only.
QDRANT_URL=https://your-cluster.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=support_tickets_v1
QDRANT_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_DENSE_VECTOR_SIZE=384
QDRANT_SPARSE_MODEL=qdrant/bm25
QDRANT_DENSE_VECTOR=dense
QDRANT_SPARSE_VECTOR=bm25

# Retrieval
RETRIEVAL_DEFAULT_MODE=hybrid
RETRIEVAL_PREFETCH_LIMIT=50
RETRIEVAL_RRF_K=60
RETRIEVAL_TIMEOUT_SECONDS=60
RETRIEVAL_BATCH_SIZE=64

# Central raw preprocessing and future token-aware indexing. Existing datasets are never overwritten.
# PREPROCESS_INPUT=data/raw/tickets.csv
# PREPROCESS_HF_DATASET=miku1211/customer-support-tickets
# PREPROCESS_HF_REVISION=exact-40-character-dataset-commit
PREPROCESS_SOURCE_DATASET=tobiasbueck/multilingual-customer-support-tickets
PREPROCESS_RETRIEVAL_ROWS=16000
PREPROCESS_DEV_ROWS=2000
PREPROCESS_EVAL_ROWS=2000
PREPROCESS_RANDOM_SEED=42
PREPROCESS_TARGET_LANGUAGES=["en"]
PREPROCESS_MIN_QUERY_CHARS=20
PREPROCESS_MAX_QUERY_CHARS=20000
PREPROCESS_NEAR_DUP_THRESHOLD=0.88
PREPROCESS_HASH_FEATURES=65536
PREPROCESS_NEIGHBOR_BATCH_SIZE=256
PREPROCESS_OUTPUT_ROOT=data/preprocessing_runs
PREPROCESS_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
PREPROCESS_DENSE_MAX_TOKENS=256
PREPROCESS_SPARSE_MAX_TOKENS=2048
PREPROCESS_SPARSE_ISSUE_FRACTION=0.5

# Authentication
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers. GROQ/GEMINI are also used by the separate offline relevance judge.
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Phase 3 response generation. Alternatives must be explicitly enabled/selected.
GENERATION_PROVIDER=groq
GENERATION_ENABLED_PROVIDERS=["groq"]
GENERATION_GROQ_MODEL=openai/gpt-oss-120b
GENERATION_GEMINI_MODEL=gemini-3.5-flash-lite
GENERATION_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GENERATION_TEMPERATURE=0
GENERATION_MAX_OUTPUT_TOKENS=1536
GENERATION_TIMEOUT_SECONDS=30
GENERATION_CONTEXT_CHARS=8000
GENERATION_REQUESTS_PER_MINUTE=6
GENERATION_TOKENS_PER_MINUTE=6000

# Phase 4 orchestration is opt-in; all limits are server-controlled.
ORCHESTRATION_ENABLED=false
ORCHESTRATION_INVESTIGATION_ENABLED=true
ORCHESTRATION_KNOWLEDGE_ENABLED=true
ORCHESTRATION_TIMEOUT_SECONDS=120
ORCHESTRATION_MAX_RETRIEVALS=2
ORCHESTRATION_MAX_DRAFTS=2
ORCHESTRATION_MAX_LLM_ATTEMPTS=4
ORCHESTRATION_MAX_TOKENS=12000
ORCHESTRATION_MAX_STEPS=16

# Offline LLM relevance judging (evaluation only; never used by the runtime API)
JUDGE_PROVIDER=groq
JUDGE_MODEL=
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_OUTPUT_TOKENS=1024
JUDGE_REASONING_EFFORT=low
JUDGE_TIMEOUT_SECONDS=60
JUDGE_MAX_RETRIES=5
JUDGE_OUTPUT_RETRIES=2
JUDGE_BACKOFF_BASE_SECONDS=2
JUDGE_BACKOFF_MAX_SECONDS=60
JUDGE_REQUESTS_PER_MINUTE=0
JUDGE_MAX_DOCUMENT_CHARS=4000

# Observability (Phase 10+)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional cache (Phase 2+)
REDIS_URL=redis://localhost:6379/0
